# ──────────────────────────────────────────────────────────────
# BunMail — Environment Variables
#
# Copy this file to .env and fill in the values.
# Required variables are marked with (required).
# ──────────────────────────────────────────────────────────────

# ── Environment ──
# "development" — relaxed: allows sending from unregistered domains
# "production"  — strict: requires registered + DKIM-verified domains
BUNMAIL_ENV=development

# ── DKIM Encryption Key (required) ──
# 32 random bytes, base64-encoded. Used to encrypt every domain's DKIM
# private key at rest with AES-256-GCM. A DB dump without this key
# leaks no signing material.
#
# Generate one with: openssl rand -base64 32
#
# Rotation requires re-encrypting existing rows — see SECURITY.md.
# DO NOT change this in-place on a running system; reads will fail.
DKIM_ENCRYPTION_KEY=

# ── Database (required) ──
# PostgreSQL connection URL (used when running without Docker Compose)
DATABASE_URL=postgres://bunmail:changeme@localhost:5432/bunmail

# ── Docker Compose Postgres ──
# These are used by docker-compose.yml to configure the PostgreSQL container.
# POSTGRES_PASSWORD is required — pick a strong, unique password.
POSTGRES_USER=bunmail
POSTGRES_PASSWORD=changeme
POSTGRES_DB=bunmail

# ── HTTP Server ──
PORT=3000
HOST=0.0.0.0

# Public base URL of this instance (e.g. https://mail.example.com), no
# trailing slash. Used to build absolute links in outbound system mail —
# currently the "view in dashboard" link in inbound notifications. Leave
# empty to omit those links.
# APP_BASE_URL=https://mail.example.com

# Skip the public landing page at GET / and redirect visitors instead, e.g.
# "/dashboard" or "https://webmail.example.com". Empty keeps the landing page.
LANDING_REDIRECT=

# ── Webmail (Kurrier) ──
# Optional modern webmail for mailbox users, bundled in docker-compose (see
# docs/webmail.md). Users sign in with their mailbox address + password;
# Kurrier's databases live in BunMail's Postgres. Generate secrets with
# `openssl rand -hex 16` / `openssl rand -base64 32`.
KURRIER_WEB_URL=https://webmail.example.com
# Keep signups open only while creating the first account, then set to true.
KURRIER_DISABLE_SIGNUP=true
KURRIER_DB_PASSWORD=
BAIKAL_DB_PASSWORD=
BAIKAL_ENCRYPTION_KEY=
KURRIER_JWT_SECRET=
KURRIER_APP_SECRET_ENCRYPTION_KEY=
KURRIER_REDIS_PASSWORD=
KURRIER_TYPESENSE_API_KEY=
KURRIER_GARAGE_ACCESS_KEY=
KURRIER_GARAGE_SECRET_KEY=
KURRIER_GARAGE_RPC_SECRET=

# ── Email Delivery ──
# Hostname used in the SMTP HELO command and Message-ID header.
# Should match your server's PTR (reverse DNS) record for best deliverability.
MAIL_HOSTNAME=mail.example.com

# Max parallel SMTP sessions per destination MX host. Direct-to-MX
# delivery means strict receivers (Outlook, Yahoo) reject parallel
# sessions from the same source IP with a 421 error. Default 1 is
# safe for new self-hosters with cold IP reputation. Operators with
# established IP rep can dial this up to 2-3; values above 3 are
# rarely worth it and risk reputation damage on strict receivers.
MAIL_MX_CONCURRENCY=1

# ── Inbound SMTP Server ──
# Set to "true" to enable the inbound SMTP server for receiving emails.
# When using Docker Compose, you ALSO need to uncomment the inbound SMTP
# port line in docker-compose.yml — otherwise the host port isn't bound
# and external senders get "connection refused". See docs/inbound.md.
SMTP_ENABLED=false
# Port for the inbound SMTP server. Use 25 in production with Docker
# (the container runs as root and can bind low ports); 2525 is the
# local-dev default for non-root environments.
SMTP_PORT=2525

# Expect a HAProxy PROXY protocol header on inbound connections. docker-compose
# sets this to true because port 25 is published by the `smtp-tls` STARTTLS
# front (Bun cannot do STARTTLS server-side), which forwards the real client
# IP this way. Leave false when the receiver is exposed directly.
SMTP_PROXY_PROTOCOL=false

# ── SMTP Spam Protection ──
# All layers are enabled by default when the SMTP server is on.
# Check connecting IPs against a DNSBL (DNS blackhole list)
SMTP_DNSBL_ENABLED=true
# DNSBL zone to query (Spamhaus ZEN combines SBL + XBL + PBL)
SMTP_DNSBL_ZONE=zen.spamhaus.org
# Reject mail to domains not registered in BunMail
SMTP_RECIPIENT_VALIDATION=true
# Per-IP connection rate limiting
SMTP_RATE_LIMIT_ENABLED=true
# Max connections per IP per window
SMTP_RATE_LIMIT_MAX=10
# Rate limit window in seconds
SMTP_RATE_LIMIT_WINDOW=60

# ── SMTP Submission Server (#120) ──
# Lets SMTP-capable apps (Infisical, Netbird, Dify, a Nodemailer backend, …)
# send THROUGH BunMail: point their SMTP host/port here and use a BunMail
# API key (bm_live_…) as the password (any username works, e.g. "apikey").
# Separate from the inbound receiver above. When using Docker Compose you
# ALSO need to uncomment the submission port line in docker-compose.yml.
# See docs/smtp-submission.md.
SMTP_SUBMISSION_ENABLED=false
# Port for the submission server (587 = IANA submission port).
SMTP_SUBMISSION_PORT=587
# Implicit-TLS submission port (SMTPS, 465). Opened only when the TLS cert
# below is configured. This is the port to give mail clients and apps.
# The plaintext port (587) never offers STARTTLS under Bun, so it is only
# usable on a trusted network with SMTP_SUBMISSION_ALLOW_INSECURE=true.
# 0 disables the TLS listener.
SMTP_SUBMISSION_TLS_PORT=465
# Per-API-key daily send quota for the submission path (#123). Counts
# messages accepted per key per UTC day; over-quota submissions get SMTP
# 452 until the next UTC day. 0 = unlimited (default). Does not affect the
# REST send API. Usage + remaining quota: GET /api/v1/smtp-submission/stats.
SMTP_SUBMISSION_DAILY_QUOTA=0
# Optional TLS. When BOTH a cert and key path are set, an implicit-TLS
# listener (SMTPS, SMTP_SUBMISSION_TLS_PORT) is opened so clients can AUTH
# over TLS. STARTTLS on the plaintext port is not offered (the socket
# upgrade is not implemented by Bun). Provide PEM file paths readable by
# the container.
SMTP_SUBMISSION_TLS_CERT=
SMTP_SUBMISSION_TLS_KEY=
# Allow AUTH over a PLAINTEXT (non-TLS) connection. The password is a
# full-privilege bm_live_ key, so plaintext AUTH exposes it to anyone who
# can sniff the link. Default false: with neither TLS nor this flag the
# submission server REFUSES TO START. Set true only when it's reachable
# solely over a trusted network (same host / private Docker network).
SMTP_SUBMISSION_ALLOW_INSECURE=false
# Per-IP connection rate limiting.
SMTP_SUBMISSION_RATE_LIMIT_ENABLED=true
SMTP_SUBMISSION_RATE_LIMIT_MAX=30
SMTP_SUBMISSION_RATE_LIMIT_WINDOW=60
# Per-IP failed-AUTH throttle — blunts API-key brute-forcing. After MAX
# failures within WINDOW seconds an IP is rejected before the key is checked.
SMTP_SUBMISSION_AUTH_RATE_LIMIT_ENABLED=true
SMTP_SUBMISSION_AUTH_RATE_LIMIT_MAX=10
SMTP_SUBMISSION_AUTH_RATE_LIMIT_WINDOW=900

# ── IMAP Mailboxes (Dovecot) ──
# Real mailboxes for Outlook / Thunderbird / Apple Mail / phones. See
# docs/mailboxes.md. Dovecot authenticates against the `mailboxes` table in
# this same Postgres; BunMail delivers inbound mail for enabled mailboxes to
# Dovecot over LMTP and still processes it as usual (logs, webhooks).
# Master switch. Management (API + dashboard) works regardless; delivery and
# mailbox SMTP AUTH only happen when true.
MAILBOXES_ENABLED=false
# Dovecot LMTP endpoint (private Docker network). docker-compose sets these.
MAILBOX_LMTP_HOST=dovecot
MAILBOX_LMTP_PORT=24
# Default quota for new mailboxes, in MB.
MAILBOX_DEFAULT_QUOTA_MB=1024
# Hostnames shown to users in the "mail client settings" block. Must be
# DNS-only (not proxied) records pointing at this server. Default to
# MAIL_HOSTNAME.
# MAILBOX_IMAP_HOST=imap.example.com
# MAILBOX_IMAP_PORT=993
# MAILBOX_SMTP_HOST=smtp.example.com
# Accept `user@domain` + mailbox password on the SMTP submission server
# (same credentials for incoming and outgoing). From is pinned to the
# mailbox address. Default true.
MAILBOX_SMTP_AUTH_ENABLED=true
# Host ports for Dovecot in docker-compose (container ports are fixed).
IMAPS_PORT=993
IMAP_PORT=143

# ── TLS for mail (acme sidecar, Let's Encrypt via Cloudflare DNS-01) ──
# One certificate covering the mail hostnames, shared by Dovecot (IMAPS)
# and BunMail's SMTP submission STARTTLS. Space-separated; first = CN.
ACME_DOMAINS=mail.example.com imap.example.com smtp.example.com
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=admin@example.com
# Cloudflare API token with Zone → DNS → Edit on the zone (nothing else).
CF_DNS_API_TOKEN=
# Optional: zone id / account id (skips the zone lookup).
CF_ZONE_ID=
CF_ACCOUNT_ID=
# Use the Let's Encrypt STAGING CA while testing (avoids rate limits).
ACME_STAGING=false

# ── Inbound Notifications (#106) ──
# When an inbound message is received for a domain that has a notify
# address set (per-domain, from the dashboard or the domains API), BunMail
# sends a "you have new mail" summary email to that address, signed with
# the recipient domain's own DKIM key. Point each domain's notify address
# at an EXTERNAL mailbox — an address on a domain BunMail itself receives
# for would loop (and is skipped by the sender-domain loop guard).
#
# Master kill switch. When false, no inbound notifications are sent
# regardless of any domain's notify address. Default: true
INBOUND_NOTIFY_ENABLED=true
# Local-part of the notification From address. The full From is
# <local>@<recipient domain>. Default: notifications
INBOUND_NOTIFY_FROM_LOCAL=notifications

# ── Dashboard ──
# Password for the /dashboard web UI. Leave empty to disable the dashboard.
DASHBOARD_PASSWORD=
# Secret for signing session cookies. REQUIRED when BUNMAIL_ENV=production
# (the app refuses to start without it) — a stable value keeps sessions
# valid across restarts and consistent across replicas. In development it
# defaults to a random UUID (sessions reset on restart). Generate one with
# `openssl rand -hex 32`.
SESSION_SECRET=

# Number of trusted reverse-proxy hops in front of BunMail, used to resolve the
# real client IP for login rate limiting (#109). 0 = trust only the raw socket
# IP (ignore X-Forwarded-For; spoof-proof, correct when directly exposed). Set
# to 1 behind a single nginx/Caddy/Cloudflare (N for N chained proxies) — the
# Nth X-Forwarded-For entry from the right is used. Default: 0
DASHBOARD_TRUSTED_PROXY_HOPS=0

# Dashboard login brute-force protection (#109). Failed password attempts are
# counted per client IP in a sliding window; once the max is hit the login POST
# returns HTTP 429 until the window expires. A successful login clears the count.
DASHBOARD_LOGIN_RATE_LIMIT_ENABLED=true
# Failed attempts allowed per IP per window before lockout. Default: 5
DASHBOARD_LOGIN_RATE_LIMIT_MAX=5
# Lockout window in seconds. Default: 900 (15 minutes)
DASHBOARD_LOGIN_RATE_LIMIT_WINDOW=900

# ── Logging ──
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Redact recipient/sender email addresses in log records (e.g.
# "a***@example.com" instead of "alice@example.com"). Defaults to
# `true` when BUNMAIL_ENV=production and `false` otherwise so dev
# logs stay debuggable. Override explicitly here.
# LOG_REDACT_PII=true

# ── Trash / Soft Delete ──
# How many days a deleted email (outbound or inbound) stays in trash
# before being permanently purged. Default: 7
TRASH_RETENTION_DAYS=7

# How many days a hard-deleted outbound email's tombstone (#34) is kept
# before the audit-trail row itself is reaped. Tombstones preserve
# identifiers (id, message_id, to, subject, status) past the trash
# purge so operators can trace late complaints / bounces back to a
# sent message. Body bytes are NEVER kept. Default: 90 days.
TOMBSTONE_RETENTION_DAYS=90

# ── Webhook Delivery Queue (#30) ──
# How many days `delivered` webhook delivery rows are kept before the
# hourly cleanup task deletes them. `failed` rows are kept indefinitely
# so operators can audit "did this event ever land?" months later.
# Default: 30
WEBHOOK_DELIVERY_RETENTION_DAYS=30
# SSRF guard (#128): webhook URLs must be https and must not resolve to a
# private/loopback/link-local/metadata address. Set to true to also allow
# plaintext http targets (the private-range block still applies). Default: false
WEBHOOK_ALLOW_INSECURE_HTTP=false
